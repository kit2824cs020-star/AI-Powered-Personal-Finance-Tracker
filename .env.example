JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
AI_SERVICE_URL=http://ai-service:8000
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
